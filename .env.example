# Copy this file to .env.local and fill in the values (.env.local is not committed).

# reCAPTCHA Enterprise site key used by Firebase App Check (public, not a secret).
# Firebase console > App Check > Apps > your web app > reCAPTCHA Enterprise.
VITE_RECAPTCHA_SITE_KEY=

# Optional: a fixed App Check debug token for `npm run dev` (keep this one private).
# Leave empty and the browser console prints a new one to register.
VITE_APPCHECK_DEBUG_TOKEN=
