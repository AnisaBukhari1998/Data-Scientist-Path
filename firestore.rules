rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents: Only authenticated owner can read or write their info
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Nested sub-collections (e.g. users/{userId}/progress)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Study pathway progress documents
    match /progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Capstone projects and GitHub submissions
    match /capstones/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Community & Global Leaderboards:
    // Signed-in users can read all entries, but users can only write/update their own score
    match /leaderboards/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Success stories written by learners.
    // Anyone can read them. Only a signed-in user can add one, under their own ID,
    // with only the expected fields and reasonable lengths. Authors can delete
    // their own story; nobody can edit one after it is posted.
    match /success_stories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['authorId', 'name', 'role', 'path', 'quote', 'img', 'timestamp'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.role is string && request.resource.data.role.size() > 0 && request.resource.data.role.size() <= 120
        && request.resource.data.path is string && request.resource.data.path.size() <= 40
        && request.resource.data.quote is string && request.resource.data.quote.size() > 0 && request.resource.data.quote.size() <= 1000
        && request.resource.data.img is string && request.resource.data.img.size() <= 16
        && request.resource.data.timestamp is int;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Community Forum / Posts
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
  }
}
